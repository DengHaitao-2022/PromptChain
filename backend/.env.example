# LLM Provider 配置（至少配置一个，Google 使用 GEMINI_API_KEY）
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 可选：本地 Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# 默认使用的 Provider
DEFAULT_LLM_PROVIDER=openai
# 可选值: openai, anthropic, ollama, google

# 默认模型（例如 Google 可设置为 gemini-2.5-flash）
DEFAULT_MODEL_NAME=gpt-4o

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptchain
# 开发环境可使用 SQLite: sqlite+aiosqlite:///./promptchain.db

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
