# LLM Provider 配置（至少配置一个）
# 当前代码仅支持：openai / anthropic / ollama
# 若你只有 Google Generative Language API key，需要先补 google provider 支持
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 可选：本地 Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# 默认使用的 Provider
DEFAULT_LLM_PROVIDER=anthropic
# 可选值: openai, anthropic, ollama

# 默认模型
DEFAULT_MODEL_NAME=claude-3-5-sonnet-20241022

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptchain
# 开发环境可使用 SQLite: sqlite+aiosqlite:///./promptchain.db

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
