# LLM Provider 配置（至少配置一个，Google 使用 GEMINI_API_KEY，GitHub Models 使用 GITHUB_MODEL_TOKEN）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_MODEL_TOKEN=

# 可选：本地 Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# 默认使用的 Provider
DEFAULT_LLM_PROVIDER=anthropic
# 可选值: openai, anthropic, ollama, google, github

# 默认模型（例如 Google 可设置为 gemini-2.5-flash，GitHub Models 可设置为 openai/gpt-4.1）
DEFAULT_MODEL_NAME=claude-3-5-sonnet-20241022

# 数据库配置（PostgreSQL）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=promptchain
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptchain
DATABASE_POOL_RECYCLE_SECONDS=1800
# 开发环境可使用 SQLite: sqlite+aiosqlite:///./promptchain.db

# Redis / 工作流事件总线配置
# 本地单进程默认使用 memory；多 worker/多实例部署请改为 redis。
REDIS_URL=redis://localhost:6380/0
WORKFLOW_EVENT_BUS_BACKEND=memory
WORKFLOW_EVENT_BUS_REDIS_CHANNEL_PREFIX=promptchain:workflow-events

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 生产环境 DEBUG=false 时必须显式设置，用于签发和校验 JWT。
JWT_SECRET_KEY=change-me-use-a-long-random-secret
# 生产环境必须使用独立 Fernet 密钥，可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
SECRETS_ENCRYPTION_KEY=
COOKIE_SECURE=false
# Docker Compose 生产示例使用的宿主机端口；如被占用可按需改写。
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 前端生产构建变量；NEXT_PUBLIC_* 会进入浏览器环境，禁止放置密钥。
NEXT_PUBLIC_API_URL=http://localhost:8000

# 邮件发送配置
# 未配置 SMTP_USER/SMTP_PASSWORD 时，后端会走开发模式：不真实发送邮件，只记录脱敏摘要。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@promptchain.com
# 587 常用 STARTTLS：SMTP_USE_TLS=true 且 SMTP_USE_SSL=false。
# 465 常用直连 SSL：SMTP_USE_TLS=false 且 SMTP_USE_SSL=true。
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
APP_BASE_URL=http://localhost:3000
EMAIL_DEV_LOG_BODY=false

# 知识库 / RAG 配置
KNOWLEDGE_STORAGE_DIR=./.data/knowledge
KNOWLEDGE_OBJECT_STORAGE_BACKEND=local
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_ENDPOINT_URL=
KNOWLEDGE_S3_REGION=us-east-1
KNOWLEDGE_S3_ACCESS_KEY_ID=
KNOWLEDGE_S3_SECRET_ACCESS_KEY=
KNOWLEDGE_S3_PREFIX=knowledge
KNOWLEDGE_S3_FORCE_PATH_STYLE=true
KNOWLEDGE_EMBEDDING_PROVIDER=hash
KNOWLEDGE_EMBEDDING_MODEL=promptchain-hash-embedding-v1
KNOWLEDGE_EMBEDDING_DIMENSION=1536
KNOWLEDGE_EMBEDDING_FALLBACK_TO_HASH=true
KNOWLEDGE_ALLOW_EXTERNAL_EMBEDDING_FOR_PRIVATE_SCOPES=false
KNOWLEDGE_MAX_UPLOAD_BYTES=20971520
KNOWLEDGE_MAX_DOCUMENTS_PER_KB=200
KNOWLEDGE_INDEX_WORKER_ENABLED=true
KNOWLEDGE_INDEX_WORKER_INTERVAL_SECONDS=2
KNOWLEDGE_INDEX_WORKER_BATCH_SIZE=5
KNOWLEDGE_INDEX_WORKER_STALE_SECONDS=900
KNOWLEDGE_INDEX_QUEUE_BACKEND=database
KNOWLEDGE_INDEX_QUEUE_REDIS_STREAM=promptchain:knowledge-index
KNOWLEDGE_INDEX_QUEUE_REDIS_GROUP=knowledge-index-workers
KNOWLEDGE_INDEX_QUEUE_REDIS_CONSUMER=
KNOWLEDGE_INDEX_QUEUE_BLOCK_MS=1000
KNOWLEDGE_INDEX_QUEUE_MAXLEN=10000
KNOWLEDGE_GENERATION_EVAL_PROVIDER=heuristic
KNOWLEDGE_GENERATION_EVAL_ALLOW_EXTERNAL_JUDGE=false
KNOWLEDGE_RAGAS_MODEL=gpt-4o-mini
